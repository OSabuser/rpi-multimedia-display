# =============================================================================
# .env.example — шаблон конфигурации
# Скопировать в .env и заполнить: cp .env.example .env
# .env не коммитится в git
# =============================================================================

# ─── Raspberry Pi ────────────────────────────────────────────────────────────

# Hostname или IP Pi (меняется под конкретное устройство)
PI_HOST=indicator-95e49a.local
PI_USER=pi
PI_DIR=/home/pi/indicator

# ─── Сборка ──────────────────────────────────────────────────────────────────

BUILD_DIR=build
